# POLARIS local — copy to .env (never commit .env)

# --- Docker Compose (recommended) ---
# cp .env.example .env && docker compose up --build
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POSTGRES_PORT=5432
API_PORT=8000

# Inside compose the API uses hostname `postgres`:
POLARIS_DATABASE_URL=postgresql+psycopg://polaris:polaris@postgres:5432/polaris

# --- Host-only API (make api) — override URL to localhost ---
# POLARIS_DATABASE_URL=postgresql+psycopg://polaris:polaris@localhost:5432/polaris

# Force in-memory storage even when DATABASE_URL is set (pytest default)
# POLARIS_USE_MEMORY_REPO=1

# Horizon MapLibre base map (optional; requires outbound HTTPS for OSM tiles)
# POLARIS_MAP_TILE_ENABLED=1
# POLARIS_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Disable tiles explicitly: POLARIS_MAP_TILE_URL=off

# Optional live HTTP smoke (hits open-meteo.com) — not used by default compose demo
# POLARIS_LIVE_SMOKE=1

# Optional MQTT/NATS (not required for MVP demo):
# docker compose --profile optional up --build
