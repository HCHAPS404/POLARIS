# POLARIS local dev — copy to .env (never commit .env)

POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_DB=polaris
POLARIS_DATABASE_URL=postgresql+psycopg://polaris:polaris@localhost:5432/polaris

# Force in-memory storage even when DATABASE_URL is set (pytest default)
# POLARIS_USE_MEMORY_REPO=1

# Optional live HTTP smoke (hits open-meteo.com)
# POLARIS_LIVE_SMOKE=1
