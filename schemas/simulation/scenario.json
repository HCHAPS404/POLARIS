{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/simulation/scenario.json",
  "title": "SimulationScenario",
  "description": "Digital Testbed scenario. SIMULATED flood-bogota-demo and HISTORICAL_REPLAY flood-mocoa-2017-replay are IMPLEMENTED.",
  "type": "object",
  "required": ["scenario_id", "seed", "evidence", "data_class"],
  "properties": {
    "scenario_id": { "type": "string" },
    "seed": { "type": "integer" },
    "hazard_id": { "type": "string" },
    "fixtures": { "type": "array", "items": { "type": "string" } },
    "data_class": { "type": "string", "enum": ["SIMULATED", "HISTORICAL_REPLAY"] },
    "evidence": { "type": "string" },
    "formula_version": { "type": "string" }
  }
}
