{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/observation/observation.json",
  "title": "Observation",
  "description": "Typed observation. V1 flood slice accepts data_class=SIMULATED only. Never fake LIVE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "observed_at",
    "observed_property",
    "value",
    "unit",
    "quality_flag",
    "source_id",
    "source",
    "data_class",
    "spatial_unit_id",
    "site_id",
    "country_iso",
    "phi_mode",
    "geometry"
  ],
  "properties": {
    "observation_id": { "type": "string", "format": "uuid" },
    "observed_at": { "type": "string", "format": "date-time" },
    "observed_property": { "type": "string", "const": "rainfall_mm" },
    "value": { "type": "number", "minimum": 0 },
    "unit": { "type": "string", "const": "mm" },
    "quality_flag": { "type": "string", "enum": ["unknown", "raw", "qc_pass", "qc_fail"] },
    "source_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "data_class": { "type": "string", "const": "SIMULATED" },
    "spatial_unit_id": { "type": "string" },
    "site_id": { "type": "string" },
    "country_iso": { "type": "string", "minLength": 2, "maxLength": 2 },
    "phi_mode": { "type": "string", "enum": ["DETECTION", "NOWCAST", "FORECAST"] },
    "geometry": { "type": "object" },
    "provenance": { "type": "object" }
  }
}
