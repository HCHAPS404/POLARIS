{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POLARIS Horizon offline cache manifest",
  "type": "object",
  "required": ["schema_version", "data_class", "fixture_id", "fetched_at", "geojson"],
  "properties": {
    "schema_version": { "const": "horizon.offline.v0.1.0" },
    "data_class": { "enum": ["SIMULATED", "HISTORICAL_REPLAY"] },
    "fixture_id": { "type": "string" },
    "seed": { "type": "integer" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string" },
    "geojson": { "type": "object" }
  },
  "additionalProperties": false
}
